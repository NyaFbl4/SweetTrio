<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:Button
        name="main-menu-level-cell-button"
        class="main-menu-level-cell-button"
        text=""
        style="
            width: 162px;
            height: 162px;
            margin-top: 6px;
            margin-bottom: 6px;
            margin-left: 6px;
            margin-right: 6px;
            padding-top: 8px;
            padding-bottom: 10px;
            padding-left: 8px;
            padding-right: 8px;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            background-color: rgba(232, 179, 105, 1);
            border-top-left-radius: 18px;
            border-top-right-radius: 18px;
            border-bottom-left-radius: 18px;
            border-bottom-right-radius: 18px;
            border-left-width: 3px;
            border-right-width: 3px;
            border-top-width: 3px;
            border-bottom-width: 3px;
            border-left-color: rgba(196, 135, 64, 1);
            border-right-color: rgba(196, 135, 64, 1);
            border-top-color: rgba(196, 135, 64, 1);
            border-bottom-color: rgba(196, 135, 64, 1);
        "
    >
        <ui:VisualElement
            name="main-menu-level-cell-stars"
            class="main-menu-level-cell-stars"
            style="
                width: 96px;
                height: 40px;
                margin-top: 2px;
            "
        />

        <ui:VisualElement
            name="main-menu-level-cell-number-plate"
            style="
                width: 132px;
                height: 90px;
                background-color: rgba(242, 189, 115, 1);
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
                border-bottom-left-radius: 16px;
                border-bottom-right-radius: 16px;
                border-left-width: 2px;
                border-right-width: 2px;
                border-top-width: 2px;
                border-bottom-width: 2px;
                border-left-color: rgba(199, 143, 77, 1);
                border-right-color: rgba(199, 143, 77, 1);
                border-top-color: rgba(199, 143, 77, 1);
                border-bottom-color: rgba(199, 143, 77, 1);
                align-items: center;
                justify-content: center;
                margin-bottom: 6px;
            "
        >
            <ui:Label
                name="main-menu-level-cell-number-label"
                text="1"
                style="
                    unity-text-align: middle-center;
                    -unity-font-style: bold;
                    font-size: 52px;
                    color: rgba(84, 46, 18, 1);
                "
            />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
