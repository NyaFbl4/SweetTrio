<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="rules-overlay" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: center; justify-content: center; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px;">
        <ui:VisualElement name="rules-panel" style="width: 860px; max-width: 92%; max-height: 94%; min-height: 580px; align-items: center; justify-content: flex-start; background-image: resource('UI/EndGamePanel/bg'); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; position: relative; padding-left: 24px; padding-right: 24px; padding-top: 34px; padding-bottom: 30px;">
            <ui:VisualElement name="rules-title-panel" style="background-image: resource('UI/banner_no_bg'); width: 620px; max-width: 78%; height: 188px; justify-content: center; align-items: center; margin-bottom: 2px;">
                <ui:Label name="rules-title-label" text="RULES" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; unity-text-align: middle-center; -unity-font-style: bold; font-size: 66px; color: rgb(255, 242, 230); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(158, 54, 78);" />
            </ui:VisualElement>

            <ui:Button name="rules-close-button" style="position: absolute; right: 14px; top: 10px; width: 112px; height: 112px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-image: resource('UI/Buttons/play'); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill;" />

            <ui:VisualElement name="rules-main-label" style="width: 100%; max-width: 680px; flex-grow: 1; min-height: 0; padding-left: 36px; padding-right: 36px; padding-top: 24px; padding-bottom: 24px; background-image: resource('UI/EndGamePanel/table'); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; justify-content: flex-start;">
                    <ui:Label name="rules-main-title-label" text="Level rules" style="-unity-font-style: bold; font-size: 40px; color: rgb(103, 53, 24); unity-text-align: upper-center; margin-bottom: 14px;" />
                <ui:ScrollView name="rules-scroll-view" style="flex-grow: 1; min-height: 0; width: 100%;">
                    <ui:Label name="rules-main-text-label" text="Match identical desserts in lines of 3 or more to earn points.&#10;&#10;The longer the combo, the higher the reward.&#10;&#10;Make matches quickly and chain combos to get bonus points.&#10;&#10;Time left at the end of a level is converted into extra points.&#10;&#10;Stars for the result:&#10;1 star — from 1500 points&#10;2 stars — from 3000 points&#10;3 stars — from 4500 points" style="-unity-font-style: normal; font-size: 32px; color: rgb(114, 62, 26); unity-text-align: upper-left; white-space: normal; line-height: 38px;" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
