<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="rules-overlay" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: center; justify-content: center;">
        <ui:VisualElement name="rules-panel" style="width: 850px; height: 1412px; align-items: center; justify-content: flex-start; background-image: resource(&apos;UI/EndGamePanel/bg&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; position: relative; align-content: auto;">
            <ui:VisualElement name="rules-title-panel" style="background-image: resource(&apos;UI/banner_no_bg&apos;); width: 620px; min-width: 620px; max-width: 620px; height: 200px; min-height: 200px; max-height: 200px; top: -88px; justify-content: center; align-items: center;">
                <ui:Label name="rules-title-label" text="ПРАВИЛА" style="margin-top: 0; unity-text-align: middle-center; -unity-font-style: bold; font-size: 72px; color: rgb(255, 242, 230); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(158, 54, 78); margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-center; top: -20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="rules-main-label" style="width: 600px; min-width: 600px; max-width: 600px; min-height: 900px; max-height: 900px; margin-top: 0; padding-left: 40px; padding-right: 40px; padding-top: 0; padding-bottom: 48px; background-image: resource(&apos;UI/EndGamePanel/table&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; align-self: center; justify-content: flex-start; height: 850px; top: -48px;">
                <ui:Label name="rules-main-title-label" text="Правила уровня" style="-unity-font-style: bold; font-size: 44px; color: rgb(103, 53, 24); unity-text-align: upper-center; margin-bottom: 26px;" />
                <ui:Label name="rules-main-text-label" text="Собирай одинаковые десерты в ряд по 3 и больше, чтобы получать очки.&#10;&#10;Чем длиннее комбинация, тем больше награда.&#10;&#10;Собирай десерты быстро и делай комбо подряд, чтобы получить бонусные очки.&#10;&#10;Оставшееся в конце уровня время превращается в дополнительные очки.&#10;&#10;Звезды за результат:&#10;1 звезда — от 1500 очков&#10;2 звезды — от 3000 очков&#10;3 звезды — от 4500 очков" style="-unity-font-style: normal; font-size: 34px; color: rgb(114, 62, 26); unity-text-align: upper-left; white-space: normal; line-height: 42px;" />
            </ui:VisualElement>
            <ui:Button name="rules-close-button" style="margin-top: 0; width: 150px; height: 150px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-image: resource(&apos;UI/Buttons/play&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; left: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
