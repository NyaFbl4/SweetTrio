<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement
        name="top-counter-container"
        style="
            position: absolute;
            left: 0;
            right: 0;
            top: 16px;
            align-items: center;
            justify-content: center;
        "
    >
        <ui:VisualElement
            name="counter-panel"
            style="
                width: 280px;
                min-height: 92px;
                background-color: rgba(255, 255, 255, 0.62);
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                padding-top: 8px;
                padding-bottom: 8px;
            "
        >
            <ui:Label
                name="level-counter-label"
                text="Score: 0"
                style="
                    unity-text-align: middle-center;
                    -unity-font-style: bold;
                    font-size: 28px;
                    color: rgba(0, 0, 0, 1);
                "
            />
            <ui:Label
                name="total-desserts-label"
                text="Desserts: 0"
                style="
                    unity-text-align: middle-center;
                    font-size: 20px;
                    color: rgba(0, 0, 0, 1);
                "
            />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement
        name="bonus-widget-container"
        style="
            position: absolute;
            left: 0;
            right: 0;
            top: 124px;
            align-items: center;
            justify-content: center;
        "
    >
        <ui:VisualElement
            name="bonus-widget-panel"
            style="
                width: 230px;
                height: 84px;
                background-color: rgba(255, 255, 255, 0.58);
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                flex-direction: row;
                align-items: center;
                justify-content: center;
                gap: 12px;
                padding-left: 10px;
                padding-right: 10px;
            "
        >
            <ui:VisualElement
                name="bonus-dessert-image"
                style="
                    width: 56px;
                    height: 56px;
                    background-color: rgba(0, 0, 0, 0);
                    border-top-left-radius: 8px;
                    border-top-right-radius: 8px;
                    border-bottom-left-radius: 8px;
                    border-bottom-right-radius: 8px;
                    -unity-background-scale-mode: scale-to-fit;
                    background-position-x: center;
                    background-position-y: center;
                    background-repeat: no-repeat;
                "
            />
            <ui:Label
                name="bonus-multiplier-label"
                text="x1.50"
                style="
                    unity-text-align: middle-center;
                    -unity-font-style: bold;
                    font-size: 30px;
                    color: rgba(0, 0, 0, 1);
                "
            />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement
        name="menu-container"
        style="
            position: absolute;
            left: 16px;
            top: 16px;
            align-items: center;
            justify-content: center;
        "
    >
        <ui:Button
            name="gameplay-menu-button"
            text="В меню"
            style="
                width: 160px;
                height: 70px;
                border-top-left-radius: 14px;
                border-top-right-radius: 14px;
                border-bottom-left-radius: 14px;
                border-bottom-right-radius: 14px;
                -unity-font-style: bold;
                font-size: 24px;
                color: rgba(0, 0, 0, 1);
                background-color: rgba(255, 255, 255, 0.76);
            "
        />
    </ui:VisualElement>

    <ui:VisualElement
        name="shuffle-container"
        style="
            position: absolute;
            right: 16px;
            top: 16px;
            align-items: center;
            justify-content: center;
        "
    >
        <ui:Button
            name="shuffle-button"
            text="Shuffle"
            style="
                width: 160px;
                height: 70px;
                border-top-left-radius: 14px;
                border-top-right-radius: 14px;
                border-bottom-left-radius: 14px;
                border-bottom-right-radius: 14px;
                -unity-font-style: bold;
                font-size: 24px;
                color: rgba(0, 0, 0, 1);
                background-color: rgba(255, 255, 255, 0.76);
            "
        />
    </ui:VisualElement>

    <ui:VisualElement
        name="bottom-timer-container"
        style="
            position: absolute;
            left: 0;
            right: 0;
            bottom: 16px;
            align-items: center;
            justify-content: center;
        "
    >
        <ui:VisualElement
            name="timer-panel"
            style="
                width: 80%;
                min-width: 220px;
                height: 48px;
                background-color: rgba(255, 255, 255, 0.35);
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                border-bottom-left-radius: 8px;
                border-bottom-right-radius: 8px;
                position: relative;
                overflow: hidden;
                justify-content: center;
                align-items: center;
            "
        >
            <ui:VisualElement
                name="timer-progress-fill"
                style="
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 100%;
                    background-color: rgba(95, 185, 110, 0.8);
                "
            />
            <ui:Label
                name="timer-countdown-label"
                text="00:00"
                style="
                    unity-text-align: middle-center;
                    -unity-font-style: bold;
                    font-size: 22px;
                    color: rgba(0, 0, 0, 1);
                "
            />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
