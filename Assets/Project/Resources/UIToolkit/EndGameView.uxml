<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="end-game-overlay" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: center; justify-content: center;">
        <ui:VisualElement name="end-game-panel" style="width: 720px; height: 992px; align-items: center; justify-content: flex-start; background-image: resource(&apos;UI/EndGamePanel/bg&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;">
            <ui:VisualElement style="flex-grow: 1; background-image: resource(&apos;UI/banner_no_bg&apos;); height: 200px; max-height: 200px; min-height: 200px; top: -56px; width: 800px; max-width: 500px; align-self: center; justify-content: center;">
                <ui:Label name="end-game-title-label" text="VICTORY" style="margin-top: 0; unity-text-align: middle-center; -unity-font-style: bold; font-size: 88px; color: rgb(255, 242, 230); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(158, 54, 78); -unity-text-align: middle-center; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="end-game-stars-container" style="margin-top: 4px; width: 800px; height: 300px; background-image: resource(&apos;UI/EndGamePanel/star_4&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; top: -76px;" />
            <ui:VisualElement style="flex-grow: 1; background-image: resource(&apos;UI/EndGamePanel/table&apos;); width: 424px; height: 140px; min-height: 140px; max-height: 140px; top: -60px;">
                <ui:Label name="end-game-score-label" style="margin-top: 36px; unity-text-align: middle-center; -unity-font-style: bold; font-size: 60px; color: rgb(104, 52, 22); -unity-text-align: upper-center;" />
            </ui:VisualElement>
            <ui:Label name="end-game-completion-label" style="display: none;" />
            <ui:VisualElement name="end-game-actions-row" style="margin-top: 60px; flex-direction: row; align-items: center; justify-content: center; top: -100px;">
                <ui:Button name="end-game-primary-button" style="width: 168px; height: 168px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-image: resource(&apos;UI/Buttons/restart&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill;" />
                <ui:Button name="end-game-secondary-button" style="margin-left: 48px; width: 168px; height: 168px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-image: resource(&apos;UI/Buttons/menu&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
