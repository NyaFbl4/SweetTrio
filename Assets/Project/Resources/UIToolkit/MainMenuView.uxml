<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement
        name="main-menu-overlay"
        style="
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            background-color: rgba(12, 24, 36, 0.82);
            align-items: center;
            justify-content: center;
        "
    >
        <ui:VisualElement
            name="main-menu-panel"
            style="
                width: 44%;
                min-width: 300px;
                max-width: 620px;
                min-height: 260px;
                background-color: rgba(247, 248, 250, 0.94);
                border-top-left-radius: 18px;
                border-top-right-radius: 18px;
                border-bottom-left-radius: 18px;
                border-bottom-right-radius: 18px;
                align-items: center;
                justify-content: center;
                padding-top: 24px;
                padding-bottom: 24px;
            "
        >
            <ui:Label
                name="main-menu-title-label"
                text="Sweet Trio"
                style="
                    unity-text-align: middle-center;
                    -unity-font-style: bold;
                    font-size: 46px;
                    color: rgba(14, 20, 28, 1);
                "
            />
            <ui:Label
                name="main-menu-subtitle-label"
                text="Прототип главного меню"
                style="
                    margin-top: 8px;
                    unity-text-align: middle-center;
                    font-size: 22px;
                    color: rgba(40, 48, 60, 0.92);
                "
            />
            <ui:Button
                name="main-menu-start-button"
                text="Старт уровня"
                style="
                    margin-top: 26px;
                    width: 220px;
                    height: 62px;
                    -unity-font-style: bold;
                    font-size: 24px;
                    color: rgba(18, 18, 18, 1);
                    background-color: rgba(255, 221, 132, 0.95);
                    border-top-left-radius: 12px;
                    border-top-right-radius: 12px;
                    border-bottom-left-radius: 12px;
                    border-bottom-right-radius: 12px;
                "
            />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
