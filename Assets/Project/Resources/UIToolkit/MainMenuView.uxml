<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Resources/UIToolkit/MainMenuView.uss?fileID=7433441132597879392&amp;guid=096052260b6b67244bb172d9859b8eaf&amp;type=3#MainMenuView" />
    <ui:VisualElement name="main-menu-overlay" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-image: resource(&apos;UI/Menu/bg&apos;); background-color: rgb(96, 198, 209); padding-left: 16px; padding-right: 16px; padding-top: 16px; padding-bottom: 16px;">
        <ui:Button name="main-menu-settings-button" style="position: absolute; right: 20px; top: 20px; width: 112px; height: 112px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-image: resource(&apos;UI/Buttons/setting&apos;); background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill;" />
        <ui:VisualElement name="main-menu-center-column" style="width: 860px; max-width: 100%; max-height: 100%; min-height: 0; align-items: center; justify-content: center;">
            <ui:Label name="main-menu-selected-level-label" text="Current level: -" style="display: none; margin-bottom: 8px; unity-text-align: middle-center; -unity-font-style: bold; font-size: 16px; color: rgb(72, 40, 18);" />
            <ui:VisualElement name="main-menu-levels-tab" style="width: 760px; max-width: 100%; flex-grow: 1; min-height: 0; align-items: center; justify-content: flex-start; background-image: resource(&apos;UI/Level Select/bg&apos;); padding-top: 18px; padding-bottom: 20px; padding-left: 24px; padding-right: 24px;">
                <ui:VisualElement name="main-menu-banner" style="width: 620px; max-width: 88%; height: 184px; background-image: resource(&apos;UI/banner_no_bg&apos;); align-items: center; justify-content: center; margin-bottom: 8px; top: -97px;">
                    <ui:Label name="main-menu-title-label" text="LEVEL SELECT" style="unity-text-align: middle-center; -unity-font-style: bold; font-size: 56px; color: rgb(255, 247, 237); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(177, 58, 83);" />
                </ui:VisualElement>
                <ui:Label name="main-menu-empty-levels-label" text="Add level configs to level catalog" style="margin-top: 18px; unity-text-align: middle-center; font-size: 20px; color: rgb(96, 54, 19); display: none;" />
                <ui:ScrollView name="main-menu-levels-list" style="width: 100%; flex-grow: 1; min-height: 0; margin-top: 8px; top: -85px;" />
                <ui:VisualElement name="main-menu-pagination-row" style="margin-top: 8px; width: 100%; height: 86px; flex-direction: row; align-items: center; justify-content: center; top: -90px;">
                    <ui:Button name="main-menu-pagination-prev-button" style="width: 72px; height: 72px; margin-right: 18px; background-image: resource(&apos;UI/Buttons/prew&apos;); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
                    <ui:VisualElement name="main-menu-pagination-indicators" style="flex-direction: row; align-items: center; justify-content: center; margin-right: 18px;" />
                    <ui:Button name="main-menu-pagination-next-button" style="width: 72px; height: 72px; background-image: resource(&apos;UI/Buttons/next&apos;); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
